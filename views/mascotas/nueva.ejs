<h1>Registrar mascota</h1>

<form class="formulario-nueva" action="/mascotas" method="post">
  <% if (error) { %>
    <div class="alerta-error" role="alert"><%= error %></div>
  <% } %>

  <div class="campo">
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= valores.nombre || '' %>">
  </div>

  <div class="campo">
    <label for="especie">Especie</label>
    <input type="text" id="especie" name="especie" value="<%= valores.especie || '' %>">
  </div>

  <div class="campo">
    <label for="edad">Edad (en años)</label>
    <input type="number" id="edad" name="edad" value="<%= valores.edad || '' %>">
  </div>

  <div class="campo">
    <label for="estado">Estado</label>
    <select id="estado" name="estado">
      <% ['En adopción', 'Reservada', 'Adoptada'].forEach((op) => { %>
        <option value="<%= op %>" <%= valores.estado === op ? 'selected' : '' %>><%= op %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="descripcion">Descripción</label>
    <textarea id="descripcion" name="descripcion" rows="4"><%= valores.descripcion || '' %></textarea>
  </div>

  <button class="boton" type="submit">Guardar mascota</button>
</form>